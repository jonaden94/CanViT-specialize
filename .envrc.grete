# Grete cluster environment variables for CanViT-specialize.
# Copy to .envrc: cp .envrc.grete .envrc && direnv allow
# (or it will be sourced directly by slurm_nhr/env.sh in SLURM jobs)

# Caches
export HF_HOME="/user/henrich1/u25995/.cache/huggingface"
export TORCH_HOME="/user/henrich1/u25995/.cache/torch"
export TORCH_COMPILE_CACHE_DIR="/user/henrich1/u25995/.cache/torch_compile"

# Datasets
export ADE20K_ROOT="/user/henrich1/u25995/jonathan/datasets/zhoubolei--scene_parse_150/ADEChallengeData2016"

# Storage
export CHECKPOINTS_DIR="/user/henrich1/u25995/jonathan/repos/CanViT-specialize/checkpoints"

# Tracker config — choose at job time with --tracker {wandb,comet,none}
# W&B (default)
export WANDB_PROJECT="jon_exp18_canvit_specialize"
export WANDB_ENTITY=""                          # leave empty to use your default account
export WANDB_DIR="/mnt/vast-nhr/projects/nib00021/jonathan"

# Comet (used only when --tracker comet)
export COMET_WORKSPACE=""                       # TODO: set to your Comet workspace
export COMET_PROJECT_NAME="canvit-ade20k-probes"

# Credentials
if [ -f ~/comet_api_key.txt ]; then export COMET_API_KEY=$(cat ~/comet_api_key.txt); fi
if [ -f "${HF_HOME:-}/token" ] && [ -z "${HF_TOKEN:-}" ]; then export HF_TOKEN=$(cat "$HF_HOME/token"); fi
